NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
TRUST_PROXY=0
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/infra_sentinel
MIGRATE_ON_BOOT=true
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Infra Sentinel <noreply@sentinel.local>
SCHEDULER_ENABLED=true
SCHEDULER_CONCURRENCY=20
RESULT_RETENTION_DAYS=30
BLOCK_PRIVATE_TARGETS=false
METRIC_RETENTION_DAYS=14
PUBLIC_API_URL=http://localhost:4000
AGENT_DIR=../infra-sentinel-agent
APP_SECRET=infra-sentinel-development-secret-change-me
AUDIT_RETENTION_DAYS=365
WEBHOOK_RETENTION_DAYS=14
API_RATE_LIMIT_PER_MINUTE=600
SSO_ALLOW_HTTP=false
NOTIFICATION_RETENTION_DAYS=30
METRICS_TOKEN=
LOG_FORMAT=text
SIGNUPS=open
